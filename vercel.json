{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "devCommand": "npm run dev",
  "public": "dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(?!assets|images|favicon|apple-touch|manifest|robots|sitemap)(.*)", "destination": "/api" }
  ]
}
