{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "devCommand": "npm run dev",
  "functions": {
    "api/index.js": {
      "memory": 3008,
      "maxDuration": 60,
      "runtime": "nodejs24.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
