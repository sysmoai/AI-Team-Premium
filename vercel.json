{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "devCommand": "npm run dev",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/**": {
      "includeFiles": "dist/public/index.html"
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/:path*" }
  ]
}
